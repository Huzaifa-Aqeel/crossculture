# Copy to .env.local and fill in your own values. Never commit .env.local.
DATABASE_URL=
# API Lambda invokes this worker Lambda after committing a queued run.
# Leave empty when running the API and worker together in local development.
RESEARCH_WORKER_FUNCTION_NAME=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
TAVILY_API_KEY=
# Optional separate credit pool for Tavily, if configured.
TAVILY_API_KEY_2=

# Public HTTPS URL of this deployment's web/public/ucp-agent-profile.json.
# Keep empty until the profile is deployed and Shopify negotiation is verified.
SHOPIFY_UCP_PROFILE_URL=
# Enable only after a live non-native product-context recommendation has a verified cultural candidate and Shopify offer.
COMMERCE_CONTEXT_DISCOVERY_ENABLED=0
# Optional per-partner research ceilings; defaults adapt to whether an exact
# Brand A product was selected. Shopify rate limits can still stop a run sooner.
# COMMERCE_CATALOG_CALLS_PER_PARTNER=56
# COMMERCE_MAX_BROAD_PAGES=3
# COMMERCE_MAX_QUERY_SCOPES=10
# COMMERCE_MAX_PAIR_ASSESSMENTS=32
# COMMERCE_PARTNER_RESEARCH_MS=120000
# COMMERCE_RUN_RESEARCH_MS=300000
# COMMERCE_PAIR_CONCURRENCY=2
# COMMERCE_IDENTITY_CONCURRENCY=3

# Install and configure the qloo MCP command separately.
QLOO_API_KEY=

# Use "bedrock" with AWS credentials configured outside this file, or an
# OpenAI-compatible endpoint with LLM_API_URL and LLM_API_KEY.
LLM_PROVIDER=bedrock
AWS_PROFILE=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=qwen.qwen3-next-80b-a3b
LLM_API_URL=
LLM_API_KEY=
