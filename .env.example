# Copy to .env.local and fill in your own values. Never commit .env.local.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
YOUTUBE_API_KEY=
TAVILY_API_KEY=
# Optional separate credit pool for Tavily, if configured.
TAVILY_API_KEY_2=

# Install and configure the qloo MCP command separately.
QLOO_API_KEY=

# Use "bedrock" with AWS credentials configured outside this file, or an
# OpenAI-compatible endpoint with LLM_API_URL and LLM_API_KEY.
LLM_PROVIDER=bedrock
AWS_PROFILE=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=qwen.qwen3-next-80b-a3b
LLM_API_URL=
LLM_API_KEY=

YOUTUBE_SEARCH_24H_LIMIT=85
YOUTUBE_SHARED_24H_LIMIT=800
YOUTUBE_TRANSCRIPTS_ENABLED=false
